<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="gest_rest.list">
      <field name="name">gest_rest list</field>
      <field name="model">gest_rest.platos_quique</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="description"/>
          <field name="precio"/>
          <field name="descuento"/>
          <field name="tiempo_preparacion"/>
          <field name="disponible"/>
          <field name="fecha_alta"/>
          <field name="menu"/>
          <field name="categoria_ids" widget="many2one_tags"/>
          <field name="precio_con_iva"/>
          <field name="precio_final"/>
          <field name="ingredientes" widget="many2many_tags"/>
          <field name="chef_ids" widget="many2one_tags"/>
          <field name="chef_especializado"/>
        </list>
      </field>
    </record>

   <record model="ir.ui.view" id="gest_rest.view_partner_form_inherit">
    <field name="name">camareros form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml"> 
        <xpath expr="//field[@name='vat']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        <xpath expr="//page[@name='contact_addresses']" position="attributes">
            <attribute name="invisible">1</attribute> 
        </xpath>

        <xpath expr="//field[@name='function']" position="after">
            <field name="seccion"/>
        </xpath>

        <xpath expr="//page[@name='internal_notes']" position="after">
            <page name="camarero" string="Datos Camarero" invisible="not es_camarero">
                <group>
                    <group>
                        <field name="es_camarero" invisible="1"/> 
                        <field name="turno"/>
                        <field name="menu_especialidad" widget="many2many_tags"/>
                    </group>
                </group>
            </page>
        </xpath>

    </field>
</record>
    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="gest_rest.abrir_platos">
      <field name="name">gest_rest window</field>
      <field name="res_model">gest_rest.platos_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gest_rest.abrir_menu">
      <field name="name">gest_rest window</field>
      <field name="res_model">gest_rest.menu_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gest_rest.abrir_ingredientes">
      <field name="name">gest_rest window</field>
      <field name="res_model">gest_rest.ingrediente_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gest_rest.abrir_categoria">
      <field name="name">gest_rest window</field>
      <field name="res_model">gest_rest.categoria_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gest_rest.abrir_chef">
      <field name="name">gest_rest window</field>
      <field name="res_model">gest_rest.chef_quique</field>
      <field name="view_mode">list,form</field>
    </record>

  <!--camaero-->
  <record model="ir.actions.act_window" id="gest_rest.abrir_camarero">
      <field name="name">gest_rest window</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[("es_camarero", "=", True)]</field>
      <field name="context">{'default_es_camarero': True}</field>
    </record>

    
    <record model="ir.actions.act_window.view" id="action_view_camareros_list">
      <field name="sequence" eval="1"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="gest_rest.abrir_camarero"/>
    </record>
    <record model="ir.actions.act_window.view" id="gest_rest.action_camareros_form">
      <field name="sequence" eval="2"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="gest_rest.view_partner_form_inherit"/>
      <field name="act_window_id" ref="gest_rest.abrir_camarero"/>
    </record>


    <!-- server action to the one above -->
<!--
    <record model="ir.actions.server" id="gest_rest.action_server">
      <field name="name">gest_rest server</field>
      <field name="model_id" ref="model_gest_rest_gest_rest"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->

    <menuitem name="gest_rest" id="gest_rest.menu_root"/>

    <!-- menu categories -->
    <menuitem name="Menu" id="gest_rest.menu" parent="gest_rest.menu_root"/>
<!--
    <menuitem name="Menu 2" id="gest_rest.menu_2" parent="gest_rest.menu_root"/>
-->
    <!-- actions -->
    <menuitem name="Platos" id="gest_rest.platos" parent="gest_rest.menu"
              action="gest_rest.abrir_platos"/>
    <menuitem name="Menus" id="gest_rest.menu_menus" parent="gest_rest.menu"
          action="gest_rest.abrir_menu"/>
    <menuitem name="Ingredientes" id="gest_rest.ingre" parent="gest_rest.menu"
              action="gest_rest.abrir_ingredientes"/>
    <menuitem name="Categoria" id="gest_rest.categoria" parent="gest_rest.menu"
              action="gest_rest.abrir_categoria"/>
    <menuitem name="Chef" id="gest_rest.chef" parent="gest_rest.menu"
              action="gest_rest.abrir_chef"/>
    <menuitem name="Camarero" id="gest_rest.camarero" parent="gest_rest.menu"
              action="gest_rest.abrir_camarero"/>
    

  </data>
</odoo>
