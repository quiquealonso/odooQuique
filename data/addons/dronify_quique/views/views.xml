<odoo>
  <data>
    <!-- explicit list view definition -->

     <!--Vista del res partner heredada para pilots
   <record model="ir.ui.view" id="pilotos_list">
    <field name="name">pilotos list</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='complete_name']" position="after">
            <field name="licencia"/>
        </xpath>
        <xpath expr="//field[@name='country_id']" position="attributes">
            <attribute name="column_invisible">1</attribute>
        </xpath>
    </field>
  </record>-->

  <!--Vista del res partner heredada para clientes
  <record model="ir.ui.view" id="clientes_list">
    <field name="name">clientes list</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='country_id']" position="after">
            <field name="es_vip"/>
        </xpath>
        <xpath expr="//field[@name='phone']" position="attributes">
            <attribute name="column_invisible">1</attribute>
        </xpath>
    </field>
  </record>-->
    <!-- vista para vuelo -->
    <record model="ir.ui.view" id="vista_vuelo">
      <field name="name">vista_vuelo list</field>
      <field name="model">dronify_qap_vuelo</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="dron_id"/>
          <field name="piloto_id"/>
          <field name="peso_total"/>
          <field name="consumo_estimado" widget="monetary" options="{'symbol': '%'}" readonly="1"/>          <field name="preparado" widget="boolean" class="text-center" />
          <field name="realizado" widget="boolean" class="text-center"/>
        </list>
      </field>
    </record>

    <!-- vista para dron  -->
    <record model="ir.ui.view" id="vista_dron">
      <field name="name">vista_dron list</field>
      <field name="model">dronify_qap_dron</field>
      <field name="arch" type="xml">
        <list decoration-danger="bateria &lt; 25">
          <field name="name"/>
          <field name="capacidad_max"/>
          <field name="bateria" widget="progressbar"/>    
          <field name="estado" widget="badge" 
                 decoration-success="estado == 'disponible'"
                 decoration-info="estado == 'vuelo'"
                 decoration-warning="estado == 'taller'"/>          
        </list>
      </field>
    </record>

     <!-- vista para paquetes -->
    <record model="ir.ui.view" id="vista_paquete">
      <field name="name">vista_paquete list</field>
      <field name="model">dronify_qap_paquete</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"  />
        </list>
      </field>
    </record>

    <!-- formulario para dron -->
    <record model="ir.ui.view" id="dron_form">
      <field name="name">form_dron form</field>
      <field name="model">dronify_qap_dron</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="bateria" min="0" max="100"/>
              </group>
              <group>
                <field name="capacidad_max"/>
                <field name="estado"/>
              </group>  
            </group> 
            <group>
              <field name="piloto_autorizado_ids" />
            </group>   
          </sheet>
        </form>
      </field>
    </record>

    <!-- formulario para vuelo -->
    <!--  Los campos de planificación (name, dron_id, piloto_id) deben bloquearse cuando el vuelo esté preparado -->
    <!-- Lista de paquetes asignados (bloqueada cuando el vuelo esté preparado)-->
    <record model="ir.ui.view" id="vista_vuelo_form">
      <field name="name">form_vuelo form</field>
      <field name="model">dronify_qap_vuelo</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_preparar_vuelo" string="Preparar Vuelo" type="object" invisible="preparado or realizado"  class="oe_highlight"/>
            <button name="action_desbloquear" string="Modificar Datos" invisible="not preparado or realizado"  type="object"/>
            <button name="action_finalizar_vuelo" string="Marcar como Realizado" invisible="not preparado or realizado" type="object" class="oe_highlight"/>
          </header>
          <sheet>
            <group>
              <group string="Planificación">
                <field name="name" readonly="preparado"/>
                <field name="dron_id"  readonly="preparado"/>
                <field name="piloto_id"  readonly="preparado"/>
              </group>
              <group string="Estado y control">
                <field name="preparado" readonly ="1"/>
                <field name="realizado" readonly ="1"/>
              </group>
            </group>
            <notebook>
              <page string="Paquetes">
                <field name="paquetes_ids" readonly="preparado" />
                <group>
                  <group>
                    <field name="peso_total" readonly="1"/>
                    <field name="consumo_estimado" widget="monetary" options="{'symbol': '%'}" readonly="1"/>                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- formulario para pilotos -->
    <record model="ir.ui.view" id="form_piloto">
      <field name="name">form_piloto form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='function']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='website']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='contact_addresses']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='sales_purchases']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='internal_notes']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//notebook" position="before">
          <group string="Roles en dronify">
            <group>
              <field name="es_piloto" readonly="1"/>
              <field name="licencia" required ="es_piloto"/> 
              <field name="dron_autorizado_ids" widget="many2many_tags" />
            </group>
            <group>
              <field name="es_cliente"/>
              <field name="es_vip" invisible="not es_cliente"/> 
            </group>
          </group>
        </xpath>
      </field>
    </record>


    <!-- formulario para clientes -->
    <record model="ir.ui.view" id="form_cliente">
      <field name="name">form_cliente form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='function']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='website']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='contact_addresses']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='sales_purchases']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='internal_notes']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//notebook" position="before">
          <group string="Roles en dronify">
            <group> 
              <field name="es_cliente" readonly="1"/>
              <field name="es_vip" invisible="not es_cliente" />
            </group>
            <group>
              <field name="es_piloto"/>
              <field name="licencia" required="es_piloto" invisible="not es_piloto"/>            
          </group>
          </group>
        </xpath>
      </field>
    </record>

    <!-- actions opening views on models -->
    <!-- abrir los drones -->
    <record model="ir.actions.act_window" id="abrir_drones">
      <field name="name">Drones window</field>
      <field name="res_model">dronify_qap_dron</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- abrir los vuelos -->
    <record model="ir.actions.act_window" id="abrir_vuelos">
      <field name="name">Vuelos window</field>
      <field name="res_model">dronify_qap_vuelo</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- abrir los paquetes -->
    <record model="ir.actions.act_window" id="abrir_paquetes">
      <field name="name">Paquetes window</field>
      <field name="res_model">dronify_qap_paquete</field>
      <field name="view_mode">list</field>
    </record>

    <!--PARTE DE LOS CLIENTES -->
    <record model="ir.actions.act_window" id="abrir_clientes">
      <field name="name">Clientes</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('es_cliente', '=', True)]</field>
      <field name="context">{'default_es_cliente': True, 'form_view_ref': 'dronify_quique.form_cliente'}</field>
    </record>
    <!-- abrir los clientes list -->
    <record model="ir.actions.act_window.view" id="abrir_clientes_list">
      <field name="sequence" eval="1"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="abrir_clientes"/>
     </record>  
    <!-- abrir los clientes form-->
    <record model="ir.actions.act_window.view" id="abrir_clientes_form">
      <field name="sequence" eval="2"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="form_cliente"/>
      <field name="act_window_id" ref="abrir_clientes"/>
   </record>
    

    
    <!-- PARTE DE LOS PILOTOS -->
    <record model="ir.actions.act_window" id="abrir_pilotos">
      <field name="name">Pilotos</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('es_piloto', '=', True)]</field>
      <field name="context">{'default_es_piloto': True, 'form_view_ref': 'dronify_quique.form_piloto'}</field>
    </record>
    <!-- abrir los pilotos list-->
    <record model="ir.actions.act_window.view" id="abrir_pilotos_list">
      <field name="sequence" eval="1"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="abrir_pilotos"/>
    </record>
    <!-- abrir los pilotos form -->
    <record model="ir.actions.act_window.view" id="abrir_pilotos_form">
      <field name="sequence" eval="2"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="form_piloto"/>
      <field name="act_window_id" ref="abrir_pilotos"/>
    </record>



    <!-- Top menu item, Nombre que sale en el menu de la esquina izquierda -->
    <menuitem name="Dronify_QUIQUE" id="menu_izquierda"/>

    <!-- menu categories -->

    <menuitem name="Drones" id="dronify_quique.menu_drones" parent="menu_izquierda"/>
    <menuitem name="Vuelos" id="dronify_quique.menu_vuelos" parent="menu_izquierda"/>
    <menuitem name="Paquetes" id="dronify_quique.menu_paquetes" parent="menu_izquierda"/>
    <menuitem name="Clientes" id="dronify_quique.menu_clientes" parent="menu_izquierda"/>
    <menuitem name="Pilotos" id="dronify_quique.menu_pilotos" parent="menu_izquierda"/>



    <!-- actions -->

    <menuitem name="List" id="dronify_qap_dron" parent="dronify_quique.menu_drones"
              action="abrir_drones"/>
    <menuitem name="List" id="dronify_qap_vuelos" parent="dronify_quique.menu_vuelos"
              action="abrir_vuelos"/>
    <menuitem name="List" id="dronify_qap_paquetes" parent="dronify_quique.menu_paquetes"
              action="abrir_paquetes"/>
    <menuitem name="List" id="dronify_qap_clientes" parent="dronify_quique.menu_clientes"
              action="abrir_clientes"/>
    <menuitem name="List" id="dronify_qap_pilotos" parent="dronify_quique.menu_pilotos"
              action="abrir_pilotos"/>

  </data>
</odoo>
