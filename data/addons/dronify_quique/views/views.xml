    <!-- vista para vuelo -->
    <record model="ir.ui.view" id="vista_vuelo">
      <field name="name">vista_vuelo list</field>
      <field name="model">dronify_qap_vuelo</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="dron_id"/>
          <field name="piloto_id"/>
          <field name="peso_total"/>
          <field name="consumo_estimado" widget="percentage" />
          <field name="preparado" widget="boolean" class="text-center" />
          <field name="realizado" widget="boolean" class="text-center"/>
        </list>
      </field>
    </record>

    <!-- formulario para vuelo (falta añadir la pestaña de paquetes)-->
    <record model="ir.ui.view" id="vista_vuelo_form">
      <field name="name">form_vuelo form</field>
      <field name="model">dronify_qap_vuelo</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_preparar_vuelo" string="Preparar Vuelo" type="object" class="oe_highlight"/>
            <button name="action_desbloquear" string="Iniciar Vuelo" type="object"/>
            <button name="action_finalizar_vuelo" string="Finalizar Vuelo" type="object"/>
          </header>
          <sheet>
            <group>
              <group string="Planificación">
                <field name="name"/>
                <field name="dron_id"/>
                <field name="piloto_id"/>
              </group>
              <group string="Estado y control">
                <field name="preparado"/>
                <field name="realizado"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- vista para dron  -->
    
    <record model="ir.ui.view" id="vista_dron">
      <field name="name">vista_dron list</field>
      <field name="model">dronify_qap_dron</field>
      <field name="arch" type="xml">
        <list decoration-danger="bateria &lt; 25">
          <field name="name"/>
          <field name="capacidad_max"/>
          <field name="bateria" widget="progressbar"/>    
          <field name="estado" widget="badge" 
                 decoration-success="estado == 'disponible'"
                 decoration-info="estado == 'vuelo'"
                 decoration-warning="estado == 'taller'"/>          
        </list>
      </field>
    </record>

     <!-- vista para paquetes -->
    <record model="ir.ui.view" id="vista_paquete">
      <field name="name">vista_paquete list</field>
      <field name="model">dronify_qap_paquete</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"  />
        </list>
      </field>
    </record>

    <!-- actions opening views on models -->


    <!-- abrir los drones -->
    <record model="ir.actions.act_window" id="abrir_drones">
      <field name="name">Drones window</field>
      <field name="res_model">dronify_qap_dron</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- abrir los vuelos -->
    <record model="ir.actions.act_window" id="abrir_vuelos">
      <field name="name">Vuelos window</field>
      <field name="res_model">dronify_qap_vuelo</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- abrir los paquetes -->
    <record model="ir.actions.act_window" id="abrir_paquetes">
      <field name="name">Paquetes window</field>
      <field name="res_model">dronify_qap_paquete</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- abrir los clientes -->
    <record model="ir.actions.act_window" id="abrir_clientes">
      <field name="name">Contactos window</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- abrir los pilotos -->
    <record model="ir.actions.act_window" id="abrir_pilotos">
      <field name="name">Contactos window</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
    </record>






    <!-- server action to the one above -->
