    <!-- Top menu item, Nombre que sale en el menu de la esquina izquierda -->
    <menuitem name="Dronify_QUIQUE" id="menu_izquierda"/>

    <!-- menu categories -->

    <menuitem name="Drones" id="dronify_quique.menu_drones" parent="menu_izquierda"/>
    <menuitem name="Vuelos" id="dronify_quique.menu_vuelos" parent="menu_izquierda"/>
    <menuitem name="Paquetes" id="dronify_quique.menu_paquetes" parent="menu_izquierda"/>
    <menuitem name="Contactos" id="dronify_quique.menu_contactos" parent="menu_izquierda"/>


    <!-- actions -->

    <menuitem name="List" id="dronify_qap_dron" parent="dronify_quique.menu_drones"
              action="abrir_drones"/>
    <menuitem name="List" id="dronify_qap_vuelos" parent="dronify_quique.menu_vuelos"
              action="abrir_vuelos"/>
    <menuitem name="List" id="dronify_qap_paquetes" parent="dronify_quique.menu_paquetes"
              action="abrir_paquetes"/>
    <menuitem name="List" id="dronify_qap_contactos" parent="dronify_quique.menu_contactos"
              action="abrir_contactos"/>

  </data>
</odoo>
