<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="gestion_tareas_quique.list">
      <field name="name">tareas_quique list</field>
      <field name="model">gestion_tareas_quique.tareas_quique</field>
      <field name="arch" type="xml">
        <list>
          <field name ="codigo"/>
          <field name="nombre"/>
          <field name="descripcion"/>
          <field name="finalizado"/>
          <field name ="proyecto_ids"/>
          <field name ="proyecto_default"/>

        </list>
      </field>
    </record>

  <record model="ir.ui.view" id="gestion_tareas_quique.form">
      <field name="name">tareas_quique list</field>
      <field name="model">gestion_tareas_quique.tareas_quique</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
             <field name="codigo"/>
              <field name="nombre"/>
              <field name="descripcion"/>
              <field name="finalizado"/>
              <field name ="historia"/>
              <field name ="proyecto_ids"/>
              <field name ="responsable"/>
              <field name ="proyecto_default"/>
            </group>
            <group>
              <field name="fecha_creacion"/>
              <field name="fecha_ini"/>
              <field name="fecha_fin"/>
              <field name="sprint"/>
              <field name="rel_tecnologias" widget="many2many_tags"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>


     <record model="ir.ui.view" id="gestion_tareas_quique.view_partner_form_inherit">
      <field name="name">desarrolladores form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
          <xpath expr="//sheet/notebook/page[@name='internal_notes']" position="after">
            <page name="devs" string="Datos Desarrollador">
                <group>
                    <group>
                        <field name="tecnologias_ids" widget="many2many_tags"/>`
                        <field name ="es_desarrollador"/>
                    </group>
                </group>
            </page>
          </xpath> 
      </field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="gestion_tareas_quique.action_tareas_window">
      <field name="name">gestion_tareas_quique window</field>
      <field name="res_model">gestion_tareas_quique.tareas_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gestion_tareas_quique.action_sprints_window">
      <field name="name">gestion_sprints_quique window</field>
      <field name="res_model">gestion_tareas_quique.sprints_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gestion_tareas_quique.action_historias_window">
      <field name="name">gestion_historias_quique window</field>
      <field name="res_model">gestion_tareas_quique.historias_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gestion_tareas_quique.action_proyectos_window">
      <field name="name">gestion_proyectos_quique window</field>
      <field name="res_model">gestion_tareas_quique.proyectos_quique</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.act_window" id="gestion_tareas_quique.action_desarrolladores_window">
      <field name="name">desarrolladores window</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
    </record> 


    <record model="ir.actions.act_window.view" id="action_view_desarrolladores_list">
      <field name="sequence" eval="1"/>
      <field name="view_mode">list</field>
      <field name="view_id" ref="base.view_partner_tree"/>
      <field name="act_window_id" ref="gestion_tareas_quique.action_desarrolladores_window"/>
    </record>


    <record model="ir.actions.act_window.view" id="action_view_desarrolladores_form">
      <field name="sequence" eval="2"/>
      <field name="view_mode">form</field>
      <field name="view_id" ref="gestion_tareas_quique.view_partner_form_inherit"/>
      <field name="act_window_id" ref="gestion_tareas_quique.action_desarrolladores_window"/>
    </record>

    <!-- server action to the one above -->
<!--
    <record model="ir.actions.server" id="gestion_tareas_quique.action_server">
      <field name="name">gestion_tareas_quique server</field>
      <field name="model_id" ref="model_gestion_tareas_quique_gestion_tareas_quique"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->

    <menuitem name="Gestor Tareas" id="gestion_tareas_quique.menu_root"/>

    <!-- menu categories -->
    <menuitem name="Proyectos" id="gestion_tareas_quique.proyectos" parent="gestion_tareas_quique.menu_root" sequence="10"/>
    <menuitem name="Historias" id="gestion_tareas_quique.historias" parent="gestion_tareas_quique.menu_root" sequence="20"/>
    <menuitem name="Tareas" id="gestion_tareas_quique.tareas" parent="gestion_tareas_quique.menu_root" sequence="30"/>
    <menuitem name="Sprints" id="gestion_tareas_quique.sprints" parent="gestion_tareas_quique.menu_root" sequence="40"/>
    <menuitem name="Desarrolladores" id="gestion_tareas_quique.desarrolladores" parent="gestion_tareas_quique.menu_root" sequence="50"/>



    <!-- actions -->

    <menuitem name="List" id="gestion_tareas_quique.tareas_list" parent="gestion_tareas_quique.tareas"
              action="gestion_tareas_quique.action_tareas_window"/>

    <menuitem name="Listado Sprints" id="gestion_tareas_quique.sprints_list" parent="gestion_tareas_quique.sprints"
              action="gestion_tareas_quique.action_sprints_window"/>
    
    <menuitem name="Listado Historias" id="gestion_tareas_quique.historias_list" parent="gestion_tareas_quique.historias"
              action="gestion_tareas_quique.action_historias_window"/>
      
    <menuitem name="Listado Proyectos" id="gestion_tareas_quique.proyectos_list" parent="gestion_tareas_quique.proyectos"
              action="gestion_tareas_quique.action_proyectos_window"/>

    <menuitem name="Listado Desarrolladores" id="gestion_tareas_quique.desarrolladores_list" parent="gestion_tareas_quique.desarrolladores"
              action="gestion_tareas_quique.action_desarrolladores_window"/>
    

  </data>
</odoo>
